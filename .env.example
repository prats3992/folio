# Postgres connection string. Use Neon's *pooled* URL in production
# (…-pooler.….neon.tech). Any other Postgres URL (e.g. local Docker) also works.
DATABASE_URL=

# Better Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public origin of the app (used for auth callbacks and OpenRouter attribution)
BETTER_AUTH_URL=http://localhost:3000

# https://openrouter.ai/keys — free models only, no credits required
OPENROUTER_API_KEY=

# Optional: override model slots (comma-separated, first = primary, rest = fallbacks)
# AI_MODELS_STRUCTURED=nvidia/nemotron-3-super-120b-a12b:free,google/gemma-4-31b-it:free
# AI_MODELS_CHAT=nvidia/nemotron-3-ultra-550b-a55b:free,nvidia/nemotron-3-super-120b-a12b:free
# AI_MODELS_CODE=nvidia/nemotron-3-ultra-550b-a55b:free,cohere/north-mini-code:free
